# API Gateway — Environment Template
# Copy to .env and fill in EVERY value. No defaults for secrets.
# When running via docker-compose, these are interpolated from the root .env.

# ============================================================
# RUNTIME
# ============================================================
SERVER_PORT=8000
ENV_MODE=DEV
LOG_LEVEL=trace
LOG_DIR=/var/log/m_sql_studio

# ============================================================
# CLIENT / CORS
# ============================================================
CLIENT_URL=http://127.0.0.1:3000

# ============================================================
# DATABASES (constructed from root .env in docker-compose)
# ============================================================
MONGO_URI=mongodb://API_GATEWAY_MONGO_USER:API_GATEWAY_MONGO_PASSWORD@mongo1:27017,mongo2:27017,mongo3:27017/API_GATEWAY_MONGO_DB?replicaSet=rs0&authSource=API_GATEWAY_MONGO_DB
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

# ============================================================
# SANDBOX POSTGRES
# ============================================================
SANDBOX_PG_HOST=postgres
SANDBOX_PG_PORT=5432
SANDBOX_PG_DATABASE=POSTGRES_DB
SANDBOX_PG_USER=SANDBOX_PG_USER
SANDBOX_PG_PASSWORD=SANDBOX_PG_PASSWORD

# ============================================================
# MESSAGE QUEUE
# ============================================================
BULLMQ_SQL_QUEUE_NAME=sql-queue

# ============================================================
# INTERNAL AUTH
# ============================================================
INTERNAL_API_KEY=INTERNAL_API_KEY
ADMIN_SECRET_CODE=ADMIN_SECRET_CODE

# ============================================================
# BETTER-AUTH
# ============================================================
BETTER_AUTH_SECRET=BETTER_AUTH_SECRET
BETTER_AUTH_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PROBLEMS_REPO=maverickreal/m_sql_studio_problems
GITHUB_PROBLEMS_LOCAL_DIR=
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=DEFAULT_ADMIN_PASSWORD

# ============================================================
# SMTP Configuration for Email Verification
# ============================================================
# Email verification is required for email/password signup. OAuth is untouched.
# All SMTP_* vars are optional; if unset, the gateway boots and logs a warning,
# skipping sending without crashing.
#
# DEPLOY NOTE: Brevo (formerly Sendinblue) Free Tier SMTP
#
# Documented example values:
#   - host smtp-relay.brevo.com
#   - port 587 with STARTTLS
#   - user = Brevo SMTP login
#   - pass = Brevo SMTP key
#   - from = a validated Brevo sender address
#
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<Brevo SMTP login>
#   SMTP_PASS=<Brevo SMTP key>
#   SMTP_FROM=<a validated Brevo sender address>
#
# Where to get each value:
#   Go to Brevo dashboard > Settings > SMTP & API (https://app.brevo.com/settings/keys/smtp):
#   - host smtp-relay.brevo.com: Set SMTP_HOST to smtp-relay.brevo.com
#   - port 587 with STARTTLS: Set SMTP_PORT to 587 (uses STARTTLS)
#   - user = Brevo SMTP login: Find your login email in Brevo dashboard > Settings > SMTP & API
#   - pass = Brevo SMTP key: Click "Generate a new SMTP key" in Brevo dashboard > Settings > SMTP & API
#   - from = a validated Brevo sender address: Add and verify your sender email under Brevo dashboard > Senders, Domains & Dedicated IPs > Senders
#
# Brevo Free-Tier Notes:
#   - Brevo free-tier sender-verification requirement: Sender email must be verified in Brevo before sending.
#   - ~300 emails/day free limit: Brevo free tier allows sending up to ~300 emails/day.
# ============================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# AI HINTS
# ============================================================
HINT_ENABLED=true
HINT_API_URL=http://127.0.0.1:3208/v1
HINT_API_KEY=
HINT_MODEL=LFM2.5-8B-A1B-MLX-6bit
HINT_ALLOW_REMOTE=false
HINT_REMOTE_API_URL=
HINT_REMOTE_API_KEY=
HINT_REMOTE_MODEL=gemini-3.5-flash
HINT_SAY=false
HINT_CONSENT_PATH=./logs/say-consent.json
HINT_AUDIT_PATH=./logs/hint-audit.jsonl

# ============================================================
# AI PROVIDER (legacy / alternative to HINT_*)
# ============================================================
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_API_URL=

# ============================================================
# SECRETS CHECKLIST (all must be set in .env for production)
# ============================================================
# MONGO_URI (or components: API_GATEWAY_MONGO_USER/PASSWORD/DB)
# REDIS_URL (or component: REDIS_PASSWORD)
# SANDBOX_PG_PASSWORD
# INTERNAL_API_KEY
# BETTER_AUTH_SECRET
# GOOGLE_CLIENT_SECRET
# GITHUB_CLIENT_SECRET
# GITHUB_WEBHOOK_SECRET
# DEFAULT_ADMIN_PASSWORD
# ADMIN_SECRET_CODE
# SMTP_PASS
# HINT_API_KEY (if HINT_ENABLED=true)
# HINT_REMOTE_API_KEY (if HINT_ALLOW_REMOTE=true)
# AI_API_KEY (if AI_PROVIDER != local)